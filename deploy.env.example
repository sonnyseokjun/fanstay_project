# 배포용 값 양식. 복사해서 값을 채운다:  cp deploy.env.example .env.deploy
# .env.deploy 는 .gitignore(.env.*)에 걸려 저장소에 올라가지 않는다. 이 양식 파일에는 실제 값을 쓰지 않는다.
# 각 값을 어디서 얻는지는 docs/deploy.md 참고.

# Google Cloud(=Firebase) 프로젝트 ID
GCP_PROJECT=

# Django 비밀 키. 새로 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ./deploy.sh secrets 로 Secret Manager에 올린다.
DJANGO_SECRET_KEY=

# 운영 DB 주소 (Neon의 Pooled connection 주소, sslmode=require 포함)
# ./deploy.sh secrets 로 Secret Manager에 올리고, ./deploy.sh migrate 에서도 쓴다.
DATABASE_URL=postgresql://<사용자>:<비밀번호>@<호스트>/<DB이름>?sslmode=require

# 메타 픽셀 ID (메타 이벤트 관리자에서 발급). 비워 두면 픽셀을 넣지 않는다.
META_PIXEL_ID=
