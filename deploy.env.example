# 배포용 환경변수 양식. 복사해서 값을 채운다:  cp deploy.env.example .env.deploy
# .env.deploy 는 .gitignore(.env.*)에 걸려 저장소에 올라가지 않는다. 이 양식 파일에는 실제 값을 쓰지 않는다.
# 각 값을 어디서 얻는지는 docs/deploy.md 참고.

# 컨테이너 이미지 저장소 주소 (ACR 홍콩). 태그는 deploy.sh가 커밋 번호로 붙인다.
ACR_IMAGE_REPO=registry.cn-hongkong.aliyuncs.com/<네임스페이스>/fanstay

# Django 비밀 키. 새로 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 접속을 허용할 도메인 (콤마 구분, 첫 번째가 대표 주소)
DJANGO_ALLOWED_HOSTS=<도메인>,www.<도메인>

# 관리자 로그인을 허용할 주소 (https:// 포함)
CSRF_TRUSTED_ORIGINS=https://<도메인>,https://www.<도메인>

# 운영 DB 주소 (Neon의 Pooled connection 주소). sslmode=require 필수
DATABASE_URL=postgresql://<사용자>:<비밀번호>@<호스트>/<DB이름>?sslmode=require
